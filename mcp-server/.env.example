# Supabase (server side only, never put the service key in a browser app)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 1 = log deliveries as dry runs instead of skipping when no provider is set
HERMES_DRY_RUN=0
HERMES_POLL_SECONDS=20
HERMES_SCHEDULES=1

# Sage (OpenAI-compatible; OpenRouter by default)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nousresearch/hermes-4-70b

# Scout
GOOGLE_PLACES_API_KEY=

# Herald
RESEND_API_KEY=
OUTREACH_FROM=Naim Automation Systems <hello@naimautomations.co.ke>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Echo
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Ledger + cockpit
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=